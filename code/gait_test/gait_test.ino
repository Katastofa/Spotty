/* ПРОДОЛЬНАЯ БАЗА — СНЯТА 2026-09-12. Рулетка, 186 мм.
 *
 * ИСТОРИЯ, и её стоит держать перед глазами. По STL база НЕ ОПРЕДЕЛЯЛАСЬ
 * (KINEMATICS_AUDIT.md §4): ни одна пара крепёжных отверстий плеча, боковины
 * и крышек не совпадает, поэтому по файлам нельзя было сказать, какая деталь
 * во что упирается. Детали допускали 135…232 мм — коридор шириной почти в
 * сотню миллиметров.
 *
 * ЧЕГО СТОИЛО БЫ ГАДАНИЕ. Тангаж 10° при базе 135 поднимает стопу на
 * 11.9 мм, при базе 232 — на 20.4 мм. Разница 8.5 мм БОЛЬШЕ остатка M9
 * (до 7 мм), который мы и ловим: выдуманная база испортила бы ровно тот
 * замер, ради которого всё делается. Поэтому тангаж и рыскание ОТКАЗЫВАЛИ,
 * а перенос корпуса по фазе не мог посчитать себе амплитуду.
 *
 * ТЕПЕРЬ 186 — это ЗАМЕР, а не середина коридора (ею было 180, и симулятор
 * считал на ней). Разблокировано: тангаж 'E', рыскание 'J', перенос корпуса
 * по фазе 'B'. Амплитуда переноса стала 12.47 мм вместо расчётных 12.84 на
 * принятой базе.
 *
 * СВЕРЕНО ПО ДВУМ БОРТАМ: 186 и 186. Рама не перекошена — а это отдельный
 * факт, и он тоже измерен, а не предположен. Симметрия рамы входит в каждую
 * формулу ниже: опорный прямоугольник считается прямоугольником именно
 * поэтому, и инцентр, и знак переноса корпуса опираются на это молча.
 */
static const float BASE_LAT_MM  = 78.00f; // левый ↔ правый хип. STL плеч,
                                          // 94.000 − 16.000, две детали.  M5
#define SPOTTY_BASE_LONG_MEASURED 1
static const float BASE_LONG_MM = 186.0f; // ИЗМЕРЕНО 2026-09-12, рулетка,
                                          // ось переднего хипа ↔ ось
                                          // заднего. Оба борта: 186/186. M4

// Тот же факт, но СИМВОЛОМ, а не макросом: стенд собирается отдельной
// единицей трансляции и препроцессорного флага не видит. Симулятор ставит
// статус числа по этому символу — иначе ему пришлось бы гадать по величине,
// а ненулевая база может быть и подставленной, и измеренной.
// ('extern const', а не просто 'const': const на уровне файла в C++ имеет
//  внутреннюю связь, и стенд такой символ не увидел бы.)
extern const bool BASE_LONG_IS_MEASURED;
const bool BASE_LONG_IS_MEASURED = SPOTTY_BASE_LONG_MEASURED;

