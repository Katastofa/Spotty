void releaseAll() {
  if (!DRY_RUN) {
    for (uint8_t leg = 0; leg < LEG_COUNT; leg++)
      for (uint8_t j = 0; j < JOINT_PER_LEG; j++) {
        uint8_t ch = SPOTTY_CH[leg][j];
        if (ch != 0xFF) pwm.setPWM(ch, 0, 4096);   // полное снятие сигнала
      }
    pcaAllOutputsOff();            // и разом по всем 16, включая 3/7/11/15
    if (spOscIsrOn) spottyOscProbeArm(pwm);   // вернуть меандр зонда генератора
  }
  mode = MODE_IDLE;
  havePose = false;
  engaged  = false;
  LOG.println(">> RELEASE: сигнал снят со всех каналов, серво мягкие");
}

