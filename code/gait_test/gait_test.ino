// ---------------------------------------------------------------------------
// СЫРЫЕ РЕГИСТРЫ PCA9685 — гашение выходов помимо библиотеки.
//
// ЗАЧЕМ. Перезаливка сбрасывает ESP32, но НЕ сбрасывает PCA9685: он остаётся
// под питанием со СТАРЫМ содержимым регистров ШИМ от предыдущего скетча.
// Adafruit_PWMServoDriver::begin() внутри себя делает reset (бит RESTART
// восстанавливает прежние скважности) и ставит 1000 Гц. Старые счётчики,
// снятые на 330 Гц, при 1000 Гц дают импульс втрое короче: 1500 мкс
// превращаются примерно в 495 мкс — серво срывает к краю хода, каждое в свою
// сторону. Это и есть «извернулся в разные стороны» на старте.
//
// ЛЕКАРСТВО. Погасить ВСЕ выходы битом full-off ДО pwm.begin(), тогда RESTART
// восстанавливать нечего, и окно 1000 Гц проходит вхолостую. Повторить после
// begin() и после setPWMFreq() — дёшево и снимает вопрос совсем.
//
// ALL_LED_* — широковещательные регистры, пишут разом во все 16 каналов,
// включая неиспользуемые 3, 7, 11, 15.
// ---------------------------------------------------------------------------
// ===========================================================================
// БЫСТРЫЙ ПУТЬ ЗАПИСИ В PCA9685 — добавлено 2026-08-28
// ---------------------------------------------------------------------------
// ЗАЧЕМ. Adafruit_PWMServoDriver::writeMicroseconds() перед КАЖДОЙ записью
// делает readPrescale() — то есть чтение по I2C. На двенадцать суставов это
// двенадцать чтений плюс двенадцать записей на каждый тик, да ещё арифметика
// в double. При тике 20 мс это терпимо, при тике 3 мс — нет.
//
// ЧТО ДЕЛАЕМ. Делитель читается ОДИН РАЗ при старте, из него считается длина
// такта в микросекундах, а дальше только записи. Каналы лежат подряд, и
// PCA9685 умеет автоинкремент регистров, поэтому все двенадцать уходят
// четырьмя посылками: 0..2, 4..6, 8..10, 12..14. Свободные каналы 3, 7, 11, 15
// в эти посылки не попадают и остаются погашенными.
//
// ЧЕМ ЭТО ОПАСНО И КАК ЗАКРЫТО. Вся калибровка снята через формулу библиотеки.
// Своя формула обязана давать ПОБИТОВО ТО ЖЕ ЧИСЛО ТАКТОВ, иначе поедут все
// двенадцать нулей разом. Поэтому:
//   - арифметика повторена буквально, включая double и усечение при
//     присвоении (библиотека передаёт double в uint16_t параметр setPWM);
//   - при старте выполняется сверка по всему рабочему окну 520…2380 мкс:
//     для каждого целого значения микросекунд наша формула сравнивается с
//     формулой библиотеки. Расхождение хотя бы в одном такте запрещает взвод.
// ===========================================================================
static const uint8_t PCAREG_LED0_ON_L = 0x06;   // дальше по 4 регистра на канал

double   pcaUsPerTick = 0.0;    // длина одного такта ШИМ, мкс
uint8_t  pcaPrescale  = 0;      // прочитан из драйвера один раз
bool     pcaFastReady = false;  // сверка с библиотекой пройдена
bool     pcaAlive     = false;  // PCA9685 ответил на шине (setup)

// Микросекунды -> такты. Повторяет Adafruit_PWMServoDriver::writeMicroseconds
// буква в букву, но без обращения к шине.
static inline uint16_t usToTicksBase(uint16_t us) {
  double pulse = us;
  pulse /= pcaUsPerTick;
  return (uint16_t)pulse;        // усечение — ровно как при передаче в setPWM
}

// Рабочий путь: то же плюс поправка на генератор (spotty_osc.h), 2026-09-26.
// Умножение стоит ДО усечения. При K = 1.0 результат побитово равен
// usToTicksBase — сверка с библиотекой ниже идёт именно по нему.
static inline uint16_t usToTicks(uint16_t us) {
  double pulse = us;
  pulse /= pcaUsPerTick;
  pulse *= spottyOscK;
  return (uint16_t)pulse;
}

// Непрерывный участок каналов одной посылкой.
static void pcaWriteRun(uint8_t firstCh, uint8_t count, const uint16_t *ticks) {
  Wire.beginTransmission(SPOTTY_PCA_ADDR);
  Wire.write(PCAREG_LED0_ON_L + 4 * firstCh);
  for (uint8_t i = 0; i < count; i++) {
    Wire.write(0x00);                       // ON_L
    Wire.write(0x00);                       // ON_H
    Wire.write(ticks[i] & 0xFF);            // OFF_L
    Wire.write(ticks[i] >> 8);              // OFF_H
  }
  Wire.endTransmission();
}

static const uint8_t PCAREG_ALL_LED_ON_L  = 0xFA;
static const uint8_t PCAREG_ALL_LED_ON_H  = 0xFB;
static const uint8_t PCAREG_ALL_LED_OFF_L = 0xFC;
static const uint8_t PCAREG_ALL_LED_OFF_H = 0xFD;
static const uint8_t PCABIT_FULL_OFF      = 0x10;   // бит 4 регистра OFF_H

static void pcaWrite8(uint8_t reg, uint8_t val) {
  Wire.beginTransmission(SPOTTY_PCA_ADDR);
  Wire.write(reg);
  Wire.write(val);
  Wire.endTransmission();
}

static void pcaAllOutputsOff() {
  pcaWrite8(PCAREG_ALL_LED_ON_L,  0x00);
  pcaWrite8(PCAREG_ALL_LED_ON_H,  0x00);
  pcaWrite8(PCAREG_ALL_LED_OFF_L, 0x00);
  pcaWrite8(PCAREG_ALL_LED_OFF_H, PCABIT_FULL_OFF);
}

