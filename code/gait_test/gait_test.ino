// ===========================================================================
void setup() {
  Serial.begin(115200);
  delay(300);

  // SAFETY.md п.1: ни одной позиционной команды в setup().
  if (!DRY_RUN) {
    Wire.begin(SPOTTY_I2C_SDA, SPOTTY_I2C_SCL, SPOTTY_I2C_HZ);
    // Порядок важен, см. комментарий у pcaAllOutputsOff(). Гасим выходы
    // ДО begin(), иначе RESTART внутри begin() оживит старые скважности
    // предыдущего скетча, да ещё на 1000 Гц.
    pcaAllOutputsOff();
    pwm.begin();
    Wire.setClock(SPOTTY_I2C_HZ);   // страховка: Adafruit_I2CDevice::begin()
                                    // внутри дёргает Wire.begin() без аргументов
    pcaAllOutputsOff();
    // ОБЯЗАТЕЛЬНО и ОБЯЗАТЕЛЬНО ДО setPWMFreq. Без этой строки библиотека
    // берёт своё умолчание 25 МГц, и каждый импульс выходит в 25/27 = 0.926
    // от заданного: нуль 1500 мкс превращается в 1389, это −20° по суставу.
    // Вся калибровка снята с 27 МГц (servo_hold, servo_calib, servo_test).
    pwm.setOscillatorFrequency(SPOTTY_OSC_HZ);
    pwm.setPWMFreq(SPOTTY_PWM_HZ);
    // Делитель читается с ЧИПА, один раз. Если setPWMFreq по любой причине
    // поставил не то, что мы думаем, сверка ниже это поймает.
    pcaPrescale  = pwm.readPrescale();
    /* ЖИВ ЛИ ДРАЙВЕР — добавлено 2026-09-27 после отказа на стенде.
       Без ответа PCA9685 скетч раньше работал молча: делитель читался как
       254 = 0xFE — это АДРЕС регистра делителя, который ESP32 оставляет в
       буфере, когда устройство не ответило. Сверка быстрого пути при этом
       «проходила» (обе стороны считали от одного мусора), ШИМ уходил в
       пустоту, серво стояли. Теперь: нет ACK на адресе, либо делитель
       равен 0xFE/0xFF — взвод запрещён, причина печатается. */
    Wire.beginTransmission(SPOTTY_PCA_ADDR);
    pcaAlive = (Wire.endTransmission() == 0) && pcaPrescale != 0xFE && pcaPrescale != 0xFF;
    {
      const int expect = (int)((float)SPOTTY_OSC_HZ / (SPOTTY_PWM_HZ * 4096.0f) + 0.5f) - 1;
      if (!pcaAlive) {
        LOG.println();
        LOG.printf("[!!] PCA9685 НЕ ОТВЕЧАЕТ на 0x%02X (SDA %u, SCL %u). Делитель прочитан как %u.\n",
                      SPOTTY_PCA_ADDR, SPOTTY_I2C_SDA, SPOTTY_I2C_SCL, pcaPrescale);
        LOG.println("     Взвод запрещён. Проверить: питание VCC драйвера (логика), GND,");
        LOG.println("     провода SDA/SCL и разъём на плате, перемычки адреса A0..A5.");
      } else if (abs((int)pcaPrescale - expect) > 1) {
        LOG.printf("[!] делитель %u, для %.0f Гц ожидался %d. Частота ШИМ не та, что задана.\n",
                      pcaPrescale, SPOTTY_PWM_HZ, expect);
      }
    }
    pcaUsPerTick = 1000000.0;
    pcaUsPerTick *= (uint16_t)(pcaPrescale + 1);
    pcaUsPerTick /= (double)SPOTTY_OSC_HZ;
    pcaAllOutputsOff();
    delay(50);
    releaseAll();                 // выход из setup с заведомо снятым сигналом
  }

  assumeStartPose();        // лёжа (START_LYING) либо нули — см. REST_*_DEG

  loadGaitPreset();        // действующие параметры = пресет походки по умолчанию

  LOG.println();
  LOG.println("Spotty gait_test — походки в пространстве суставов, поза приседа");
  LOG.printf("DRY_RUN=%s  PCA=0x%02X  SDA=%u SCL=%u  %.0f Гц  %.2f мкс/град\n",
                DRY_RUN ? "true" : "false", SPOTTY_PCA_ADDR,
                SPOTTY_I2C_SDA, SPOTTY_I2C_SCL, SPOTTY_PWM_HZ, SPOTTY_US_PER_DEG);
  if (!DRY_RUN) {
    LOG.println("ВНИМАНИЕ: DRY_RUN СНЯТ — скетч подаёт ШИМ на серво.");
    LOG.println("Робот должен быть ВЫВЕШЕН, питание с ограничением тока,");
    LOG.println("разрыв питания под рукой. Сигнал сейчас снят, серво мягкие.");
  }
  // ---- сверка быстрого пути записи с формулой библиотеки -------------------
  // Вся калибровка снята через Adafruit_PWMServoDriver::writeMicroseconds.
  // Быстрый путь обязан давать ТО ЖЕ число тактов на всём рабочем окне.
  // Проверка ловит опечатку в формуле и неверный делитель; она НЕ доказывает,
  // что я верно помню исходник библиотеки — это оператор видит глазом по тому,
  // что поза после перезаливки осталась прежней.
  if (!DRY_RUN) {
    int mism = 0;
    for (uint16_t us = SPOTTY_ABS_MIN_US; us <= SPOTTY_ABS_MAX_US; us++) {
      double pl = 1000000;
      uint16_t pre = pcaPrescale; pre += 1;
      pl *= pre;
      pl /= (double)SPOTTY_OSC_HZ;
      double pulse = us;
      pulse /= pl;
      uint16_t libTicks = (uint16_t)pulse;
      if (libTicks != usToTicksBase(us)) {
        if (mism < 3) LOG.printf("[!] расхождение при %u мкс: библиотека %u, быстрый путь %u\n",
                                    us, libTicks, usToTicksBase(us));
        mism++;
      }
    }
    pcaFastReady = (mism == 0);
    LOG.printf("PCA9685: делитель %u, такт %.4f мкс, 1500 мкс = %u тактов\n",
                  pcaPrescale, pcaUsPerTick, usToTicks(1500));
    if (pcaFastReady)
      LOG.printf("Сверка быстрого пути пройдена на всём окне %u..%u мкс.\n",
                    SPOTTY_ABS_MIN_US, SPOTTY_ABS_MAX_US);
    else
      LOG.printf("СВЕРКА НЕ ПРОЙДЕНА: %d расхождений. ШИМ запрещён.\n", mism);

    // Генератор PCA9685: замер по зонду и поправка. Суставы не трогает —
    // пишется только свободный канал зонда, и тот гасится после замера.
    spottyOscBoot(pwm, LOG);
  } else {
    pcaFastReady = true;
  }

  // IMU: своя шина, серво при этом мягкие — самое время калибровать гиро.
  spottyImuBegin(LOG);

  // Самопроверка таблиц пределов. Пока она не пройдена, взвод запрещён:
  // ошибка в таблице опаснее любой ошибки в траектории, потому что кламп
  // сам построен на этих таблицах.
  LOG.println();
  LOG.println("--- жёсткие пределы каналов ---");
  tablesOk = spottyLimitsSelfCheck(true) && pcaFastReady && (DRY_RUN || pcaAlive);
  LOG.println();
  if (!tablesOk)
    LOG.println("ТАБЛИЦЫ НЕСОГЛАСОВАНЫ. Команды 'n' и 'w' заблокированы.");
  preflight(true);
  help();

#if SPOTTY_WEB
  // Не блокирует: сеть поднимается отдельной задачей на ядре 0. Если сети
  // нет — скетч работает как раньше, через USB, и скажет об этом в логе.
  spottyWebBegin();
#endif
}

// ===========================================================================
// РАЗБОР КОМАНД
// ---------------------------------------------------------------------------
// Ввод построчный: у команд появились аргументы, одной клавишей их не задать.
// Две уступки практике:
//   - строка исполняется и по ПАУЗЕ, а не только по Enter: Serial Monitor
//     с настройкой «No line ending» иначе не работает вовсе;
//   - 'x' и 'r' срабатывают немедленно с одной клавиши, если строка пуста.
//     Аварийный останов не должен ждать ни Enter, ни таймаута.
// ===========================================================================
char cmdLine[40];
uint8_t cmdLen = 0;
unsigned long lastRxMs = 0;
static const unsigned long LINE_IDLE_MS = 120;

void doStop() {
  if (speedRamping) {
    speedRamping = false;
    LOG.printf(">> РАЗГОН ОСТАНОВЛЕН. Последний период %.0f мс, требовалось %.0f°/с.\n",
                  pCycleMs, peakRateDps(pCycleMs));
    LOG.println("   Это и есть замер: запиши период, при котором ноги начали отставать.");
  }
  // Во время выхода в позу цели — это КОНЕЧНАЯ поза, и HOLD без заморозки
  // довёл бы движение до конца. 'x' обязан остановить там, где стоим.
  if (mode == MODE_RAMP)
    for (uint8_t leg = 0; leg < LEG_COUNT; leg++)
      for (uint8_t j = 0; j < JOINT_PER_LEG; j++)
        tgtAngle[leg][j] = curAngle[leg][j];
  rampViaActive = false; rampToRest = false;
  trickAbort();                     // трюк замирает там, где стоит; 'n' — в позу
  mode = MODE_HOLD;
  LOG.println(">> HOLD (удержание текущего положения)");
}

// Изменение параметра запрещено на ходу: пересчёт траектории под ногами
// оператора — это ровно тот класс ошибок, от которого стоит кламп.
bool paramGuard() {
  if (mode == MODE_WALK) { LOG.println("Идёт походка. Сначала 'x'."); return false; }
  return true;
}

void afterParamChange() {
  extern int8_t profIdx;
  profIdx = -1;                             // ручная правка: это уже не профиль
  preflight(true);
}

// Присед и отношение звеньев меняют САМУ ПОЗУ, а не только траекторию.
// Робот в неё не поедет сам: смена позы под током — это движение, а движение
// начинается только по явной команде оператора.
void poseChanged() {
  if (havePose)
    LOG.println("[i] Поза изменилась. Робот стоит в прежней — 'n' переведёт в новую.");
}

/* ---------------------------------------------------------------------------
 * ОХРАНА ПАРАМЕТРОВ ПО ДВИЖКУ.
 *
 * Параметр не своего движка НЕ ИГНОРИРУЕТСЯ МОЛЧА. Молчаливое игнорирование
 * — это ровно тот случай, когда оператор крутит ручку, ничего не происходит,
 * и он делает вывод о железе. Отказ обязан назвать замену.
 * ------------------------------------------------------------------------- */
bool angularOnly(const char *what, const char *instead) {
  if (pEngine != 1) return true;
  LOG.printf("'%s' — параметр УГЛОВОГО движка, сейчас работает декартов.\n", what);
  LOG.printf("    В декартовом это: %s. Вернуть угловой: 'G 0'.\n", instead);
  return false;
}

bool cartesianOnly(const char *what, const char *instead) {
  if (pEngine == 1) return true;
  LOG.printf("'%s' — параметр ДЕКАРТОВА движка, сейчас работает угловой.\n", what);
  LOG.printf("    В угловом это: %s. Включить декартов: 'G 1'.\n", instead);
  return false;
}

/*
 * ВОРОТА ПО ЗАМЕРУ ЗВЕНЬЕВ. Декартов движок считает от STL-КАНДИДАТОВ, а не
 * от замеров. Считать по кандидатам можно и нужно — это и есть подготовка.
 * Двигать по ним железо нельзя, пока их не подтвердили штангенциркулем.
 *
 * Поэтому 'p' работает всегда, а 'n', 'w' и 'z' в декартовом режиме
 * отказывают, пока SPOTTY_LINKS_MEASURED == 0.
 */
bool linksGate() {
  if (pEngine != 1) return true;
#if SPOTTY_LINKS_MEASURED
  return true;
#else
  LOG.println();
  LOG.println("ОТКАЗ: декартов движок считает по STL-КАНДИДАТАМ, не по замерам.");
  LOG.printf("   бедро %.2f (M2), голень %.2f (M3), хип %.2f (M1) — из STL,\n",
                L_FEMUR_MM, L_TIBIA_MM, L_HIP_MM);
  LOG.println("   подгонкой окружностей по вершинам. Это кандидаты, не измерения.");
  LOG.println("   Считать по ним можно: 'p' работает и печатает все числа.");
  LOG.println("   Двигать железо — нет.");
  LOG.println();
  LOG.println("   Снять M1/M2/M3 штангенциркулем (межосевые расстояния, не габарит),");
  LOG.println("   вписать в gait_test.ino и поставить SPOTTY_LINKS_MEASURED 1.");
  LOG.println("   Пока не снято — 'G 0' и угловой движок работают как работали.");
  return false;
#endif
}

// ===========================================================================
// ПРОФИЛИ ХОДЬБЫ — команда 'M' (2026-09-30). Таблица — spotty_profiles.h.
// Профиль — это ТОЛЬКО параметры, ровно те же, что ставят g t k d T q b m f S
// (или G H P C V W B). Движения профиль не начинает: если поза изменилась,
// робот стоит в прежней, и 'n' переводит в новую — как у 'q' и 'H'.
// ===========================================================================
int8_t profIdx = -1;          // последний применённый профиль; ручная правка -> -1

void applyProfile(uint8_t i) {
  const GaitProfile &P = PROFILES[i];
  gaitIdx = P.gait;
  loadGaitPreset();
  pEngine = P.engine;
  pTrimDeg = P.b;  pMaxRateDps = P.m;
  pCrouchDeg = P.q;
  if (P.engine == 0) {
    pAmpThigh = P.t;  pAmpKnee = P.k;  pDuty = P.d;  pCycleMs = P.T;
    pFlatPath = P.f != 0;  pSmoothSwing = P.S != 0;
  } else {
    pHeightMm = P.H;  pSpanMm = P.P;  pLiftMm = P.C;  pVelMmS = P.V;  pSwingMs = P.W;
    pShiftGain = P.B;
    recalcCartesianTiming();
  }
}

void profileList() {
  LOG.println("Профили ходьбы ('M <имя|номер>'), параметры меняются, движения нет:");
  for (uint8_t i = 0; i < PROFILE_COUNT; i++)
    LOG.printf("  %2u %-8s %-20s %s%s\n", i, PROFILES[i].name, PROFILES[i].ru, PROFILES[i].note,
               (int8_t)i == profIdx ? "   <- сейчас" : "");
}

// Для стенда (trace) и пульта: таблица static, наружу — только через эти.
uint8_t profileCount() { return PROFILE_COUNT; }
const GaitProfile *profileDef(uint8_t i) { return i < PROFILE_COUNT ? &PROFILES[i] : nullptr; }

void handleLine(char *ln) {
  while (*ln == ' ' || *ln == '\t') ln++;
  if (!*ln) return;
  char cmd = *ln;
  char *rest = ln + 1;
  while (*rest == ' ' || *rest == '\t') rest++;

  // Голая цифра — число циклов, как было до появления аргументов.
  if (cmd >= '1' && cmd <= '9' && !*rest) {
    walkCycles = (uint8_t)(cmd - '0');
    LOG.printf("N = %u циклов\n", walkCycles);
    return;
  }

  switch (cmd) {
    case 'i': {                             // imu ... — IMU, только измерение
      if (strncmp(ln, "imu", 3)) { LOG.println("неизвестная команда, 'h' — справка"); return; }
      const char *ia = ln + 3; while (*ia == ' ') ia++;
      bool blocking = !strncmp(ia, "cal", 3);          // калибровка держит цикл ~1 с
      if (blocking && (mode == MODE_WALK || mode == MODE_RAMP || mode == MODE_ARM)) {
        LOG.println("Идёт движение или взвод. Сначала 'x'."); return;
      }
      spottyImuCommand(ia, LOG);
      return;
    }
    case 'o': {                             // osc ... — генератор PCA9685
      if (strncmp(ln, "osc", 3)) { LOG.println("неизвестная команда, 'h' — справка"); return; }
      if (DRY_RUN) { LOG.println("DRY_RUN: драйвера нет, мерить нечего."); return; }
      if (mode == MODE_WALK || mode == MODE_RAMP || mode == MODE_ARM) {
        LOG.println("Идёт движение или взвод. Сначала 'x'."); return;
      }
      spottyOscCommand(ln + 3, pwm, engaged, LOG);
      // В HOLD углы пересчитываются в такты каждый тик — новая K уйдёт
      // на шину сама на следующем кадре.
      return;
    }
    case 'M': {                             // профиль ходьбы, см. ПРОФИЛИ
      if (!*rest) { profileList(); return; }
      if (!paramGuard()) return;
      int found = -1;
      if (*rest >= '0' && *rest <= '9') {
        int v = atoi(rest);
        if (v >= 0 && v < (int)PROFILE_COUNT) found = v;
      } else {
        for (uint8_t i = 0; i < PROFILE_COUNT; i++)
          if (!strcmp(rest, PROFILES[i].name)) { found = i; break; }
      }
      if (found < 0) { LOG.println("нет такого профиля, 'M' — список"); return; }
      const GaitProfile &P = PROFILES[found];
      applyProfile((uint8_t)found);
      LOG.printf(">> профиль '%s' — %s\n", P.name, P.ru);
      if (P.engine == 0)
        LOG.printf("   g %u · t %.0f · k %.0f · d %.2f · T %.0f · q %.0f · b %.0f · m %.0f · f %u · S %u\n",
                   P.gait, P.t, P.k, P.d, P.T, P.q, P.b, P.m, P.f, P.S);
      else
        LOG.printf("   G 1 · g %u · H %.0f · P %.0f · C %.0f · V %.0f · W %.0f · B %.2f · m %.0f\n",
                   P.gait, P.H, P.P, P.C, P.V, P.W, P.B, P.m);
      if (P.air) LOG.println("[!!] Профиль ТОЛЬКО НА ВЕСУ: на полу он уронит робота.");
      if (P.m > 100.0f) LOG.printf("[!] Быстрый профиль (m %.0f): предел скорости серво не измерен ('z'). Сначала на подвесе.\n", P.m);
      poseChanged(); afterParamChange();
      profIdx = (int8_t)found;               // afterParamChange сбросил — ставим после
      return;
    }
    case 'e': {                             // трюки, см. ТРЮКИ
      if (!*rest) { trickList(); return; }
      if (!strncmp(rest, "hip", 3) && (rest[3] == ' ' || rest[3] == 0)) {
        const float v = atof(rest + 3);
        if (v != 1.0f && v != -1.0f) { LOG.println("e hip <1|-1>: знак хипа, проверенный 'e hiptest'"); return; }
        TRICK_HIP_OUT = v; trickHipOk = true;
        LOG.printf(">> знак хипа для трюков %+.0f, трюки с хипами открыты до перезагрузки\n", v);
        return;
      }
      int found = -1;
      if (*rest >= '0' && *rest <= '9') {
        int v = atoi(rest);
        if (v >= 0 && v < (int)TRICK_COUNT) found = v;
      } else {
        for (uint8_t i = 0; i < TRICK_COUNT; i++)
          if (!strcmp(rest, TRICKS[i].name)) { found = i; break; }
      }
      if (found < 0) { LOG.println("нет такого трюка, 'e' — список"); return; }
      if (!tablesOk) { LOG.println("Заблокировано: самопроверка пределов не пройдена."); return; }
      if (mode == MODE_WALK) { LOG.println("Идёт походка. Сначала 'x'."); return; }
      if (!engaged || !havePose || mode != MODE_HOLD) {
        LOG.println("Сначала 'n' — трюк начинается из позы."); return;
      }
      if (!trickStart((uint8_t)found, millis())) {
        LOG.printf("ОТКАЗ: трюк '%s': %s\n", TRICKS[found].name, trickErr); return;
      }
      LOG.printf(">> ТРЮК '%s' — %s. 'x' — замереть, 'n' — в позу.\n", TRICKS[found].name, TRICKS[found].ru);
      return;
    }
    case 'p': preflight(true); return;
    case 'h': help();          return;
    case 's': status();        return;
    case 'r': releaseAll();    return;
    case 'x': doStop();        return;

    case 'n':
      if (!DRY_RUN && !pcaAlive) { LOG.println("Заблокировано: PCA9685 не отвечает на шине I2C, см. лог загрузки."); return; }
      if (!tablesOk) { LOG.println("Заблокировано: самопроверка пределов не пройдена."); return; }
      if (!linksGate()) return;
      if (!preflight(false)) return;
      setTargetsToPose();
      if (engaged) {                       // уже под током — сразу рампа
        beginRamp(millis());
        LOG.println(">> RAMP -> поза");
      } else {
        armT0 = millis(); armLeftPrinted = -1; mode = MODE_ARM;
        LOG.println();
        LOG.println(">> ВЗВОД. Сейчас будет ПЕРВАЯ подача ШИМ.");
        if (START_LYING) {
          LOG.println("   Допущение: робот ЛЕЖИТ, ноги сложены (REST_*_DEG). Первый кадр");
          LOG.println("   ставит суставы туда, дальше — плавный подъём. Если робот");
          LOG.println("   висит или ноги не сложены — серво дёрнутся. Руки убрать.");
        } else {
          LOG.println("   Серво рванут из того положения, куда их увела гравитация,");
          LOG.println("   в свои нули. Ноги должны быть свободны, руки убрать.");
        }
        LOG.println("   Любая клавиша — отмена.");
      }
      return;

    case 'l':                               // лечь: плавно в позу лёжа
      if (!engaged || mode == MODE_ARM) { LOG.println("ШИМ не подан — робот и так мягкий."); return; }
      if (mode == MODE_WALK) { LOG.println("Идёт походка. Сначала 'x'."); return; }
      setTargetsToRest();
      beginRamp(millis());
      rampToRest = true;
      LOG.println(">> УКЛАДКА -> лёжа");
      return;

    case 'w':
      if (!tablesOk)  { LOG.println("Заблокировано: самопроверка пределов не пройдена."); return; }
      if (!havePose)  { LOG.println("Сначала 'n' — взвод и выход в позу."); return; }
      if (!linksGate()) return;
      if (!preflight(false)) return;
      gaitDone = 0.0f; rampLastCycle = 0; speedRamping = false; walkStopAt = 1e9f;
      walkT0 = millis(); mode = MODE_WALK;
      LOG.printf(">> WALK '%s': %u цикл(ов) по %.0f мс%s\n",
                    GAITS[gaitIdx].name, walkCycles, pCycleMs,
                    pTurn ? (pTurn > 0 ? ", разворот ВЛЕВО" : ", разворот ВПРАВО") : "");
      return;

    case 'g': {
      if (!*rest) { LOG.println("g <0..4> либо g <имя>"); return; }
      if (!paramGuard()) return;
      int found = -1;
      if (*rest >= '0' && *rest <= '9') {
        int v = atoi(rest);
        if (v >= 0 && v < (int)GAIT_COUNT) found = v;
      } else {
        for (uint8_t i = 0; i < GAIT_COUNT; i++)
          if (!strncmp(rest, GAITS[i].name, strlen(GAITS[i].name))) { found = i; break; }
      }
      if (found < 0) { LOG.println("нет такой походки, 'h' — список"); return; }
      gaitIdx = (uint8_t)found;
      loadGaitPreset();          // смена походки ВСЕГДА возвращает её пресет
      LOG.printf(">> походка '%s', параметры взяты из пресета\n", GAITS[gaitIdx].name);
      afterParamChange();
      return;
    }

    case 'c': {
      if (!paramGuard()) return;
      int v = atoi(rest);
      if (v < 1 || v > 99) { LOG.println("c <1..99>"); return; }
      walkCycles = (uint8_t)v;
      LOG.printf("N = %u циклов\n", walkCycles);
      return;
    }

    case 't': {
      if (!paramGuard()) return;
      if (!angularOnly("t", "длина шага в мм, 'P'")) return;
      float v = atof(rest);
      if (v < 0.0f || v > 60.0f) { LOG.println("t <0..60> градусов"); return; }
      pAmpThigh = v; LOG.printf("бедро ±%.1f°\n", pAmpThigh); afterParamChange(); return;
    }
    case 'k': {
      if (!paramGuard()) return;
      if (!angularOnly("k", "подъём стопы в мм, 'C'")) return;
      float v = atof(rest);
      if (v < 0.0f || v > 90.0f) { LOG.println("k <0..90> градусов"); return; }
      pAmpKnee = v; LOG.printf("колено +%.1f°\n", pAmpKnee); afterParamChange(); return;
    }
    case 'a': {
      if (!paramGuard()) return;
      float v = atof(rest);
      if (v < 0.0f || v > 20.0f) { LOG.println("a <0..20> градусов"); return; }
      pAmpHip = v; LOG.printf("хип ±%.1f°\n", pAmpHip); afterParamChange(); return;
    }
    case 'd': {
      if (!paramGuard()) return;
      if (!angularOnly("d", "duty выводится из 'V' и 'W'")) return;
      float v = atof(rest);
      if (v < 0.10f || v > 0.90f) { LOG.println("d <0.10..0.90>"); return; }
      pDuty = v; LOG.printf("duty %.2f (опора %.0f%% цикла)\n", pDuty, pDuty * 100.0f);
      afterParamChange(); return;
    }
    case 'T': {
      if (!paramGuard()) return;
      if (!angularOnly("T", "период выводится из 'V' и 'W'")) return;
      float v = atof(rest);
      if (v < 300.0f || v > 10000.0f) { LOG.println("T <300..10000> мс"); return; }
      pCycleMs = v; LOG.printf("период %.0f мс\n", pCycleMs); afterParamChange(); return;
    }
    case 'u': {
      if (!paramGuard()) return;
      int v = atoi(rest);
      if (v < -1 || v > 1) { LOG.println("u <-1|0|1>"); return; }
      pTurn = v;
      LOG.printf("разворот %s\n", v == 0 ? "выключен" : (v > 0 ? "ВЛЕВО" : "ВПРАВО"));
      afterParamChange(); return;
    }

    case 'z': {
      if (!tablesOk) { LOG.println("Заблокировано: самопроверка не пройдена."); return; }
      if (!havePose) { LOG.println("Сначала 'n' — взвод и выход в позу."); return; }
      if (!linksGate()) return;
      if (!preflight(false)) return;
      gaitDone = 0.0f; rampLastCycle = 0; speedRamping = true; walkStopAt = 1e9f;
      walkT0 = millis(); mode = MODE_WALK;
      LOG.println();
      LOG.printf(">> РАЗГОН. Период будет укорачиваться в %.2f раза каждые %u цикла,\n",
                    1.0f / SPEEDRAMP_FACTOR, SPEEDRAMP_EVERY);
      LOG.printf("   ограничитель поднимается следом (потолок %.0f°/с).\n", RATE_CEILING_DPS);
      LOG.println("   ПРЕДЕЛЫ СУСТАВОВ ПРИ ЭТОМ НЕ ТРОГАЮТСЯ — кламп работает как обычно.");
      LOG.println("   Робот вывешен, ток ограничен, разрыв под рукой.");
      LOG.println("   Жми 'x', как только ноги начнут отставать от печатаемой фазы");
      LOG.println("   либо серво загудят на упоре. Период в этот момент и есть замер.");
      return;
    }

    case 'S': {
      if (!paramGuard()) return;
      if (!angularOnly("S", "профиль переноса задан безье")) return;
      int v = atoi(rest);
      if (v < 0 || v > 1) { LOG.println("S <0|1>: 0 линейный перенос, 1 сглаженный"); return; }
      pSmoothSwing = (v != 0);
      LOG.printf("профиль переноса: %s\n", pSmoothSwing ? "СГЛАЖЕННЫЙ (стыковка по скорости)" : "линейный");
      afterParamChange(); return;
    }

    case 'm': {
      if (!paramGuard()) return;
      float v = atof(rest);
      if (v < 20.0f || v > RATE_CEILING_DPS) { LOG.printf("m <20..%.0f> градусов в секунду\n", RATE_CEILING_DPS); return; }
      pMaxRateDps = v;
      LOG.printf("ограничитель походки %.0f°/с (рампа остаётся %.0f°/с)\n",
                    pMaxRateDps, RAMP_RATE_DPS);
      afterParamChange(); return;
    }

    case 'q': {
      if (!paramGuard()) return;
      if (!angularOnly("q", "высота корпуса в мм, 'H'")) return;
      float v = atof(rest);
      if (v < 0.0f || v > 120.0f) { LOG.println("q <0..120> градусов"); return; }
      pCrouchDeg = v;
      LOG.printf("присед: колено %.0f°, бедро %.1f°, нога короче на %.0f%%\n",
                    pCrouchDeg, stanceThighDeg(),
                    100.0f * (1.0f - stanceReach() / (1.0f + linkRatio)));
      poseChanged(); afterParamChange(); return;
    }
    case 'b': {
      if (!paramGuard()) return;
      if (!angularOnly("b", "сдвиг корпуса в мм, 'X'")) return;
      float v = atof(rest);
      if (v < -20.0f || v > 20.0f) { LOG.println("b <-20..20> градусов, + = корпус вперёд"); return; }
      pTrimDeg = v;
      LOG.printf("трим корпуса %+.1f° (%s)\n", pTrimDeg,
                    pTrimDeg > 0 ? "корпус ВПЕРЁД относительно стоп"
                                 : (pTrimDeg < 0 ? "корпус НАЗАД" : "выключен"));
      poseChanged(); afterParamChange(); return;
    }

    case 'f': {
      if (!paramGuard()) return;
      if (!angularOnly("f", "форма опоры задаётся продавом 'A'")) return;
      int v = atoi(rest);
      if (v < 0 || v > 1) { LOG.println("f <0|1>: 0 дуга, 1 плоская"); return; }
      pFlatPath = (v != 0);
      LOG.printf("траектория стопы: %s\n", pFlatPath ? "ПЛОСКАЯ" : "дуга");
      afterParamChange(); return;
    }
    case 'L': {
      if (!paramGuard()) return;
      if (!angularOnly("L", "отношение не нужно, длины звеньев заданы прямо")) return;
      float v = atof(rest);
      if (v < 0.5f || v > 2.0f) { LOG.println("L <0.50..2.00>"); return; }
      linkRatio = v;
      LOG.printf("отношение звеньев голень/бедро k = %.2f%s\n", linkRatio,
                    fabsf(linkRatio - 1.0f) < 1e-3f ? "  (ДОПУЩЕНИЕ по умолчанию)" : "  (задано оператором)");
      poseChanged(); afterParamChange(); return;
    }

    // ---------------------------------------------------------------------
    // ДЕКАРТОВ ДВИЖОК
    // ---------------------------------------------------------------------
    case 'G': {
      if (!paramGuard()) return;
      int v = atoi(rest);
      if (v < 0 || v > 1) { LOG.println("G <0|1>: 0 угловой движок, 1 декартов"); return; }
      pEngine = v;
      if (pEngine == 1) {
        recalcCartesianTiming();
        LOG.println("движок: ДЕКАРТОВ (мм). Шаг 'P', высота 'H', подъём 'C',");
        LOG.println("   скорость 'V', перенос 'W', сдвиг корпуса 'X'/'Y', крен 'R'.");
      } else {
        LOG.println("движок: УГЛОВОЙ (градусы суставов), как было.");
      }
      poseChanged(); afterParamChange(); return;
    }

    case 'H': {
      if (!paramGuard()) return;
      if (!cartesianOnly("H", "присед в градусах колена, 'q'")) return;
      float v = atof(rest);
      const float lo = fabsf(L_FEMUR_MM - L_TIBIA_MM) + 5.0f;
      const float hi = L_FEMUR_MM + L_TIBIA_MM - 5.0f;
      if (v < lo || v > hi) { LOG.printf("H <%.0f..%.0f> мм\n", lo, hi); return; }
      pHeightMm = v;
      LOG.printf("высота: стопа на %.1f мм под осью хипа (нога вытянута на %.0f%%)\n",
                    pHeightMm, 100.0f * pHeightMm / (L_FEMUR_MM + L_TIBIA_MM));
      poseChanged(); afterParamChange(); return;
    }
    case 'P': {
      if (!paramGuard()) return;
      if (!cartesianOnly("P", "размах бедра в градусах, 't'")) return;
      float v = atof(rest);
      if (v < 0.0f || v > 120.0f) { LOG.println("P <0..120> мм (полуразмах; полный шаг вдвое больше)"); return; }
      pSpanMm = v; recalcCartesianTiming();
      LOG.printf("шаг: ±%.1f мм, полный %.1f мм; период стал %.0f мс, duty %.2f\n",
                    pSpanMm, 2.0f * pSpanMm, pCycleMs, pDuty);
      afterParamChange(); return;
    }
    case 'C': {
      if (!paramGuard()) return;
      if (!cartesianOnly("C", "подъём колена в градусах, 'k'")) return;
      float v = atof(rest);
      if (v < 0.0f || v > 80.0f) { LOG.println("C <0..80> мм"); return; }
      pLiftMm = v;
      LOG.printf("подъём стопы в переносе %.1f мм (фактический, не «добавка»)\n", pLiftMm);
      afterParamChange(); return;
    }
    case 'A': {
      if (!paramGuard()) return;
      if (!cartesianOnly("A", "аналога нет: у углового движка опора всегда прямая")) return;
      float v = atof(rest);
      if (v < 0.0f || v > 15.0f) { LOG.println("A <0..15> мм"); return; }
      pPenetMm = v;
      LOG.printf("продав опоры %.1f мм%s\n", pPenetMm,
                    pPenetMm < 0.01f ? " (опора прямая, как у углового движка)" : "");
      afterParamChange(); return;
    }
    case 'V': {
      if (!paramGuard()) return;
      if (!cartesianOnly("V", "скорость задаётся периодом 'T'")) return;
      float v = atof(rest);
      if (v < 5.0f || v > 600.0f) { LOG.println("V <5..600> мм/с"); return; }
      pVelMmS = v; recalcCartesianTiming();
      LOG.printf("скорость корпуса %.0f мм/с -> опора %.0f мс, период %.0f мс, duty %.2f\n",
                    pVelMmS, pDuty * pCycleMs, pCycleMs, pDuty);
      afterParamChange(); return;
    }
    case 'W': {
      if (!paramGuard()) return;
      if (!cartesianOnly("W", "перенос задаётся через duty 'd'")) return;
      float v = atof(rest);
      if (v < 50.0f || v > 3000.0f) { LOG.println("W <50..3000> мс — время переноса"); return; }
      pSwingMs = v; recalcCartesianTiming();
      LOG.printf("перенос %.0f мс -> период %.0f мс, duty %.2f\n",
                    pSwingMs, pCycleMs, pDuty);
      afterParamChange(); return;
    }
    case 'D': {
      if (!paramGuard()) return;
      if (!cartesianOnly("D", "аналога нет")) return;
      float v = atof(rest);
      if (v < -180.0f || v > 180.0f) { LOG.println("D <-180..180> градусов"); return; }
      pCrabDeg = v;
      LOG.printf("направление хода %+.0f° — %s\n", pCrabDeg,
                    fabsf(pCrabDeg) < 1.0f ? "вперёд" : "КРАБОМ, курс не меняется");
      if (fabsf(pCrabDeg) > 1.0f) {
        LOG.println("   Это НЕ разворот: корпус едет боком, нос смотрит туда же.");
        LOG.println("   Разворот — это 'u', он через хипы и от 'D' независим.");
      }
      afterParamChange(); return;
    }
    case 'X': {
      if (!paramGuard()) return;
      if (!cartesianOnly("X", "трим в градусах виртуальной ноги, 'b'")) return;
      float v = atof(rest);
      if (v < -80.0f || v > 80.0f) { LOG.println("X <-80..80> мм, + = корпус вперёд"); return; }
      pShiftXMm = v;
      LOG.printf("сдвиг корпуса %+.1f мм (%s; стопы уезжают в другую сторону)\n",
                    pShiftXMm, pShiftXMm > 0 ? "ВПЕРЁД" : (pShiftXMm < 0 ? "НАЗАД" : "выключен"));
      poseChanged(); afterParamChange(); return;
    }
    case 'Y': {
      if (!paramGuard()) return;
      if (!cartesianOnly("Y", "аналога нет")) return;
      float v = atof(rest);
      if (v < -60.0f || v > 60.0f) { LOG.println("Y <-60..60> мм, + = корпус влево"); return; }
      pShiftYMm = v;
      LOG.printf("боковой сдвиг корпуса %+.1f мм\n", pShiftYMm);
      poseChanged(); afterParamChange(); return;
    }
    /* ПЕРЕНОС КОРПУСА ПО ФАЗЕ. Амплитуду задать НЕЛЬЗЯ — она считается из
       геометрии (инцентр опорного треугольника). Оператору остаётся доля от
       неё: 0 выключить, 1 полный расчётный перенос. Меньше единицы — способ
       подойти к расчёту осторожно, больше — способ проверить, что дальше
       становится хуже, а не лучше. */
    case 'B': {
      if (!paramGuard()) return;
      if (!cartesianOnly("B", "аналога нет: угловой движок корпус не переносит")) return;
      float v = atof(rest);
      if (v < 0.0f || v > 1.5f) {
        LOG.println("B <0..1.5> доля РАСЧЁТНОЙ амплитуды. 0 = выключить.");
        return;
      }
      if (v > 0.0f && bodyShiftAmpMm() <= 0.0f) {
        LOG.println("ОТКАЗ: перенос корпуса требует ПРОДОЛЬНОЙ базы, а она НЕ ИЗМЕРЕНА.");
        LOG.println("   Амплитуда — это расстояние от центра прямоугольника стоп до");
        LOG.println("   инцентра опорного треугольника: sqrt(a^2+b^2) - a, где a —");
        LOG.println("   ПОЛУПРОДОЛЬНАЯ база. При a = 0 формула вырождается и даёт");
        LOG.printf("   %.1f мм — увезти корпус на всю полуширину. Это не осторожность,\n",
                      0.5f * BASE_LAT_MM + L_HIP_MM);
        LOG.println("   это опрокидывание.");
        LOG.println();
        LOG.println("   M4: рулетка, ось переднего хипа до оси заднего. Одна минута.");
        LOG.println("   Вписать BASE_LONG_MM и поставить SPOTTY_BASE_LONG_MEASURED 1.");
        return;
      }
      pShiftGain = v;
      if (pShiftGain <= 0.0f) {
        LOG.println("перенос корпуса по фазе ВЫКЛЮЧЕН (поведение как было)");
      } else {
        const float amp = bodyShiftAmpMm();
        LOG.printf("перенос корпуса по фазе ВКЛЮЧЁН: доля %.2f от расчётных %.1f мм = %+.1f мм\n",
                      pShiftGain, amp, pShiftGain * amp);
        LOG.printf("   расчёт: a=%.1f (полупродольная), b=%.1f (полупоперечная стоп)\n",
                      0.5f * BASE_LONG_MM, 0.5f * BASE_LAT_MM + L_HIP_MM);
        printShiftTable();
        LOG.println("   Знак взят из фазировки текущей походки, не из таблицы.");
      }
      afterParamChange(); return;   // позу это не меняет: сдвиг живёт в цикле
    }
    case 'R': {
      if (!paramGuard()) return;
      if (!cartesianOnly("R", "аналога нет")) return;
      float v = atof(rest);
      if (v < -25.0f || v > 25.0f) { LOG.println("R <-25..25> градусов, + = ЛЕВЫЙ борт вверх"); return; }
      pRollDeg = v;
      LOG.printf("крен %+.1f° (%s борт вверх); нужна только поперечная база %.1f мм\n",
                    pRollDeg, pRollDeg >= 0 ? "левый" : "правый", BASE_LAT_MM);
      poseChanged(); afterParamChange(); return;
    }

    /* Тангаж и рыскание заперты не из осторожности вообще, а по числу.
       Обоим нужна ПРОДОЛЬНАЯ база, а она по STL не определяется: детали
       допускают 135…232 мм. Тангаж 10° при 135 поднимает стопу на 11.9 мм,
       при 232 — на 20.4. Разница 8.5 мм БОЛЬШЕ остатка M9 (до 7 мм), ради
       которого всё и затевалось. Выдуманная база испортила бы ровно тот
       замер, который мы собираемся снимать. */
    case 'E':
    case 'J': {
      if (!paramGuard()) return;
      if (!cartesianOnly(cmd == 'E' ? "E" : "J", "аналога нет")) return;
#if SPOTTY_BASE_LONG_MEASURED
      float v = atof(rest);
      if (v < -25.0f || v > 25.0f) { LOG.println("<-25..25> градусов"); return; }
      if (cmd == 'E') { pPitchDeg = v; LOG.printf("тангаж %+.1f° (+ нос вверх)\n", pPitchDeg); }
      else            { pYawDeg   = v; LOG.printf("рыскание %+.1f° (+ нос влево)\n", pYawDeg); }
      poseChanged(); afterParamChange(); return;
#else
      LOG.printf("ОТКАЗ: %s требует ПРОДОЛЬНОЙ базы, а она НЕ ИЗМЕРЕНА.\n",
                    cmd == 'E' ? "тангаж" : "рыскание");
      LOG.println("   KINEMATICS_AUDIT.md §4: по STL не определяется, детали");
      LOG.println("   допускают 135…232 мм. Ни одна пара крепёжных отверстий");
      LOG.println("   плеча, боковины и крышек не совпадает.");
      LOG.println();
      LOG.println("   Цена гадания: тангаж 10° при базе 135 поднимает стопу на");
      LOG.println("   11.9 мм, при 232 — на 20.4. Разница 8.5 мм БОЛЬШЕ остатка");
      LOG.println("   M9 (до 7 мм), который мы и ловим. Выдуманная база испортит");
      LOG.println("   ровно тот замер, ради которого всё делается.");
      LOG.println();
      LOG.println("   M4: рулетка, ось переднего хипа до оси заднего. Одна минута.");
      LOG.println("   Вписать BASE_LONG_MM и поставить SPOTTY_BASE_LONG_MEASURED 1.");
      LOG.println("   Крен 'R' работает уже сейчас: ему хватает поперечной базы.");
      return;
#endif
    }

    default:
      LOG.println("неизвестная команда, 'h' — справка");
      return;
  }
}

#if SPOTTY_WEB
/*
 * Исполнение строки, пришедшей из браузера. Вызывается ИЗ loop(), на ядре 1,
 * то есть в том же потоке, что и разбор строки из USB.
 *
 * Повторяет семантику pollSerial в единственном особом случае: во время
 * пятисекундного отсчёта взвода ЛЮБАЯ команда — отмена. Иначе кнопка в
 * браузере вела бы себя не так, как клавиша в мониторе порта, а два разных
 * поведения у одной и той же команды — это заготовка для ошибки оператора.
 *
 * Эхо в лог обязательно: оператор должен видеть, ЧТО ушло, рядом с ответом.
 */
void webExecLine(char *ln) {
  if (mode == MODE_ARM) {
    mode = MODE_IDLE;
    LOG.println(">> ВЗВОД ОТМЕНЁН из браузера, ШИМ не подавался");
    return;
  }
  /*
   * ПОЧЕМУ СПРАВКА И СТАТУС ЗАПРЕЩЕНЫ НА ХОДУ ИМЕННО ИЗ БРАУЗЕРА.
   * help() печатает ~35 строк, status() и preflight() по 1.5…2 КБ. На 115200
   * HardwareSerial::write блокирует до вытеснения байтов, то есть 'h' — это
   * ~175 мс, а 'p'/'s' — ~130…170 мс СТОЯЩЕГО loop(). Робот замрёт посреди
   * шага и продолжит с того же места: раму это не ломает, но на полу выглядит
   * как спотыкание, а на подвесе даёт рывок.
   * С клавиатуры поведение НЕ меняем — там оператор жмёт осознанно и видит
   * порт. В браузере кнопка большая и нажимается мимоходом.
   */
  if (mode == MODE_WALK && (*ln == 'h' || *ln == 's' || *ln == 'p')) {
    LOG.printf("[веб] '%c' на ходу не выполняю: печать заняла бы сотни мс "
               "и робот споткнётся. Сначала 'x'.\n", *ln);
    return;
  }
  LOG.printf("[веб] %s\n", ln);
  handleLine(ln);
}

/*
 * Что делать при потере пульта. На ходу и под током — обычный СТОП. Во время
 * взвода останавливать нечего: отменяем сам взвод, и ШИМ не подаётся вовсе.
 */
/*
 * ПОТЕРЯ ПУЛЬТА — что делать, зависит от действия (ревизия 2026-09-27).
 * Заморозка посреди шага — худший вариант: робот стоит на двух-трёх ногах
 * в промежуточной позе. Поэтому движение ДОВОДИТСЯ до устойчивого конца:
 *   взвод (ШИМ ещё не подан)  -> отмена, как раньше;
 *   рампа в позу              -> доезжает в позу и держит её (она и так
 *                                кончается удержанием);
 *   прогон 'w'                -> доходит ТЕКУЩИЙ цикл до конца, затем
 *                                обычный возврат в позу. Оставшиеся циклы
 *                                не выполняются: без пульта робот не идёт;
 *   разгон 'z' (только на весу) -> немедленный стоп, как раньше.
 * Аварийные стопы (кламп, IK, IMU) работают независимо от этого.
 */
void webLostRemote() {
  if (mode == MODE_ARM) {
    mode = MODE_IDLE;
    LOG.println(">> ВЗВОД ОТМЕНЁН: пульт потерян до подачи ШИМ.");
    return;
  }
  if (mode == MODE_RAMP && trickIdx >= 0) {
    // Трюк без пульта не продолжаем: из любого кадра — в позу через точку.
    LOG.println(">> Пульт потерян: трюк прерван, возврат в позу.");
    setTargetsToPose();
    beginRamp(millis());
    return;
  }
  if (mode == MODE_RAMP) {
    LOG.println(">> Рампа доводится до позы, затем удержание.");
    return;
  }
  if (mode == MODE_WALK && !speedRamping) {
    float end = ceilf(gaitDone);
    if (end < 1.0f) end = 1.0f;
    walkStopAt = end;
    LOG.printf(">> Дохожу текущий цикл (%.2f из %.0f), затем поза и удержание.\n",
                  gaitDone, end);
    return;
  }
  doStop();
}
#endif

void pollSerial() {
  while (Serial.available()) {
    char c = Serial.read();

    // Во время отсчёта ЛЮБОЙ значащий символ — отмена. Это аварийный останов,
    // и он не должен зависеть ни от Enter, ни от разбора строки.
    if (mode == MODE_ARM) {
      if (c == '\n' || c == '\r' || c == ' ' || c == '\t') continue;
      mode = MODE_IDLE; cmdLen = 0;
      LOG.println(">> ВЗВОД ОТМЕНЁН, ШИМ не подавался");
      continue;
    }

    // Аварийные клавиши — немедленно, пока строка пуста.
    if (cmdLen == 0 && (c == 'x' || c == 'r')) {
      if (c == 'x') doStop(); else releaseAll();
      continue;
    }

    if (c == '\n' || c == '\r') {
      cmdLine[cmdLen] = 0;
      if (cmdLen) handleLine(cmdLine);
      cmdLen = 0;
      continue;
    }
    if (cmdLen < sizeof(cmdLine) - 1) cmdLine[cmdLen++] = c;
    lastRxMs = millis();
  }

  // Serial Monitor умеет слать без перевода строки. Исполняем по паузе.
  if (cmdLen && (millis() - lastRxMs) > LINE_IDLE_MS) {
    cmdLine[cmdLen] = 0;
    handleLine(cmdLine);
    cmdLen = 0;
  }
}

#if SPOTTY_WEB
/*
 * Снимок телеметрии для панели. Пишется ТОЛЬКО отсюда, то есть только ядром 1.
 *
 * 20 Гц, а не каждый тик: копия структуры дешёвая, но занимать ею тик 3 мс
 * незачем — панель опрашивает 5 раз в секунду.
 *
 * peakRateDps() прогоняет 400 точек траектории и в тик не помещается. Считать
 * его на ходу и не нужно: параметры во время походки менять запрещено
 * (paramGuard), значит требуемая скорость на ходу не меняется. Пересчитываем
 * на стоящем роботе, раз в секунду.
 */
uint32_t webPubAt = 0, webPeakAt = 0;
float    webPeak  = 0.0f;
bool     webPeakValid = false;

void webPublish(unsigned long now) {
  if (now - webPubAt < 50) return;
  webPubAt = now;

  /*
   * peakRateDps — 401 вызов gaitPose с тригонометрией внутри, порядка
   * 1.5…3 мс. Это ВЕСЬ бюджет тика. Считать его можно только когда серво не
   * движутся: MODE_IDLE, либо HOLD на обесточенном роботе. Прежнее условие
   * (mode != MODE_WALK) пускало расчёт в RAMP и в HOLD под током, и от этого
   * рос tickOverruns — тот самый счётчик, по которому оператору предложено
   * судить о цене Wi-Fi. Метрика травила сама себя.
   */
  const bool quiet = (mode == MODE_IDLE) || !engaged;
  if (quiet && (!webPeakValid || (now - webPeakAt) > 1000)) {
    webPeakAt = now; webPeak = peakRateDps(pCycleMs); webPeakValid = true;
  }

  SpotSnap s;
  s.ms = now;
  s.mode = (uint8_t)mode;
  s.gaitIdx = gaitIdx;
  s.walkCycles = walkCycles;
  s.engaged = engaged;  s.havePose = havePose;  s.tablesOk = tablesOk;
  s.speedRamping = speedRamping;
  s.flatPath = pFlatPath; s.smoothSwing = pSmoothSwing;
  s.turn = (int8_t)pTurn;
  s.cyclesDone = gaitDone;
  s.phase = gaitDone - floorf(gaitDone);
  for (uint8_t leg = 0; leg < LEG_COUNT; leg++)
    for (uint8_t j = 0; j < JOINT_PER_LEG; j++) s.cur[leg][j] = curAngle[leg][j];
  s.duty = pDuty;  s.ampThigh = pAmpThigh;  s.ampKnee = pAmpKnee;
  s.cycleMs = pCycleMs;  s.ampHip = pAmpHip;
  s.crouch = pCrouchDeg;  s.trim = pTrimDeg;  s.linkRatio = linkRatio;
  s.maxRate = pMaxRateDps;  s.peakRate = webPeak;
  s.limitHits = limitHits;  s.tickOverruns = tickOverruns;
  s.busUsLast = busUsLast;  s.busUsMax = busUsMax;
  s.freeHeap = ESP.getFreeHeap();
  // IMU пишется в spottyImuTick на этом же ядре — гонки нет.
  s.imuOk = spImuOk;
  s.imuRoll = spImuRoll - spImuRoll0;  s.imuPitch = spImuPitch - spImuPitch0;
  s.imuYaw = spImuYaw;
  s.imuA[0] = spImuA[0];  s.imuA[1] = spImuA[1];  s.imuA[2] = spImuA[2];
  s.imuStop = spImuStopDeg;
  s.engine = (uint8_t)pEngine;
  s.cH = pHeightMm;  s.cP = pSpanMm;  s.cC = pLiftMm;  s.cA = pPenetMm;
  s.cV = pVelMmS;    s.cW = pSwingMs; s.cD = pCrabDeg;
  s.cX = pShiftXMm;  s.cY = pShiftYMm; s.cR = pRollDeg; s.cB = pShiftGain;
  s.cPitch = pPitchDeg;  s.cYaw = pYawDeg;
  s.trick = trickIdx;  s.trickKey = trickKey;  s.trickHipOk = trickHipOk;
  s.prof = profIdx;
  spotSnapPublish(s);
}
#endif

// Один тик MODE_RAMP: профиль, конец сегмента, «через точку», кадры трюка.
void rampModeTick(unsigned long now) {
  rampTick(now);                         // плавно, все суставы вместе
  if (mode != MODE_RAMP) return;         // ограничитель объявил стоп
  // У трюка сегмент кончается ПО ВРЕМЕНИ: кадр-пауза (те же цели) иначе
  // закончился бы на первом же тике, потому что atTargets() уже истина.
  const bool segDone = (trickIdx >= 0)
      ? (now - rampT0) >= (unsigned long)rampDurMs
      : (atTargets() || (now - rampT0) > (unsigned long)(rampDurMs + RAMP_MS));
  if (segDone) {
    if (rampViaActive) {                 // первый этап из двух пройден
      rampViaActive = false;
      memcpy(tgtAngle, rampGoal, sizeof(rampGoal));
      beginRampSegment(now);
      return;
    }
    if (trickNext(now) || mode == MODE_HOLD) return;   // трюк: следующий кадр или конец
    havePose = !rampToRest;              // лёжа ходить нельзя
    mode = afterRamp;
    LOG.println(rampToRest ? "лёжа. 'r' — снять ШИМ, 'n' — встать" : "поза достигнута");
    rampToRest = false;
  }
}

void loop() {
  pollSerial();
#if SPOTTY_WEB
  // Рядом с pollSerial НАМЕРЕННО: как и 'x' с клавиатуры, СТОП из браузера
  // должен быть услышан между тиками, а не ждать следующего.
  spottyWebReport();                    // печатает только смену состояния сети
  spottyWebPump(webExecLine);           // одна команда за проход
  // Взвод тоже под охраной: при MODE_ARM engaged ещё false, а отсчёт идёт и
  // через 5 секунд сам подаст ШИМ — уже без пульта.
  spottyWebWatchdog(engaged || mode == MODE_ARM, webLostRemote);
#endif

  unsigned long now = millis();
  if (now - tickAt < TICK_MS) return;      // неблокирующий цикл: 'x' слышно всегда
  // Тик не уложился в бюджет. На 3 мс это уже не теория: печать в порт, разбор
  // команды или посылка на шину могут съесть больше. Считаем и показываем в 's',
  // потому что пропущенные тики — это молча срезанная скорость.
  if (now - tickAt > 2UL * TICK_MS && mode != MODE_IDLE) tickOverruns++;
  tickAt = now;

  // Генератор PCA9685: фоновое слежение, раз в 2 с. Новая K уходит на шину
  // сама со следующим кадром — такты пересчитываются каждый тик.
  if (!DRY_RUN) spottyOscTrackTick(pwm, LOG);

  // IMU: чтение раз в SPOTTY_IMU_PERIOD_MS, сводка по окончании прогона 'w'.
  spottyImuTick(mode == MODE_WALK, gaitDone, LOG);
  if (engaged && (mode == MODE_WALK || mode == MODE_RAMP)) {
    float r = 0, pt = 0;
    if (spottyImuTiltFault(&r, &pt)) {        // порог 0 = выключено (умолчание)
      char why[64];
      snprintf(why, sizeof(why), "IMU: крен %+.0f°, тангаж %+.0f°", r, pt);
      freezeAndHold(why);
    }
  }

  switch (mode) {
    case MODE_ARM: {
      int left = (int)((ARM_MS - (now - armT0) + 999) / 1000);
      if ((long)(now - armT0) >= (long)ARM_MS) {
        engaged = true;
        assumeStartPose();                 // серво мягкие были — где лежат, неизвестно
        beginRamp(now);
        /* ПЕРВЫЙ КАДР — посчитать ДО выдачи. Ниже по циклу pcaFlush() уйдёт на
           шину в этом же тике, а pendingTicks до этого места никто не трогал:
           там лежал кадр ПРОШЛОГО сеанса (поза до 'r'), и все 12 серво на
           первые 3 мс получали его. rampTick при t=0 выдаёт ровно стартовую
           позу. Найдено ревью 2026-09-27, подтверждено на стенде. */
        rampTick(now);
        LOG.println(">> ШИМ ПОДАН. RAMP -> поза");
      } else if (left != armLeftPrinted) {
        armLeftPrinted = left;
        LOG.printf("   %d...\n", left);
      }
      break;
    }

    case MODE_RAMP:
      rampModeTick(now);                     // вынесено: тот же тик зовёт стенд trace
      break;

    case MODE_WALK: {
      // ФАЗА КОПИТСЯ ПО ТИКАМ, а не считается как (сейчас - старт)/период.
      // Иначе смена периода на ходу — а этим занят режим разгона — швыряла бы
      // фазу скачком: одно и то же прошедшее время делится на новый период.
      // Накопление делает изменение периода бесшовным по построению.
      gaitDone += (float)TICK_MS / pCycleMs;

      if (speedRamping) {
        uint32_t c = (uint32_t)gaitDone;
        if (c != rampLastCycle) {              // прошёл очередной цикл
          rampLastCycle = c;
          if (c && (c % SPEEDRAMP_EVERY) == 0) speedRampStep();
        }
      } else if (gaitDone >= (float)walkCycles || gaitDone >= walkStopAt) {   // отходили своё — назад в позу
        setTargetsToPose();
        beginRamp(now);
        LOG.printf(">> %u цикл(ов) пройдено, возврат в позу\n", walkCycles);
        break;
      }

      float done  = gaitDone;
      float phase = done - floorf(done);
      float ang[JOINT_PER_LEG];
      ikFail = false;
      for (uint8_t leg = 0; leg < LEG_COUNT; leg++) {
        gaitPose(leg, GAITS[gaitIdx].phase[leg] + phase, ang);
        for (uint8_t j = 0; j < JOINT_PER_LEG; j++) setTarget(leg, j, ang[j]);
      }
      /* Отказ IK на ходу. Предполётная сканирует ТОТ ЖЕ цикл с шагом в тик и
         в норме ловит это до взвода, поэтому отказ здесь означает, что за
         время прогона изменилось что-то, чего меняться не должно было.
         Продолжать нельзя: углы в этот момент не вычислены, наверх ушли
         последние удачные, и с каждым тиком расхождение растёт. */
      if (ikFail) {
        LOG.printf("\n[!!] ОТКАЗ IK на ходу: нога %s, фаза %.3f\n",
                      LEG_NAME[ikFailLeg], ikFailPhase);
        freezeAndHold("стопа вне досягаемости");
        break;
      }
      if (mode != MODE_WALK) break;      // setTarget мог объявить аварийный стоп
      slewToTargets(pMaxRateDps);

      // Печать ~5 раз в секунду. Делитель считается от тика, иначе при
      // изменении TICK_MS частота печати менялась бы вместе с ним.
      static uint16_t div = 0;
      if (++div >= (200 / TICK_MS)) {
        div = 0;
        if (speedRamping)
          LOG.printf("%-6s РАЗГОН c%u T=%.0fмс лимит %.0f°/с ph=%.2f ",
                        GAITS[gaitIdx].name, (unsigned)(done) + 1, pCycleMs, pMaxRateDps, phase);
        else
          LOG.printf("%-6s c%u/%u ph=%.2f ", GAITS[gaitIdx].name,
                        (unsigned)(done) + 1, walkCycles, phase);
        for (uint8_t leg = 0; leg < LEG_COUNT; leg++) {
          LOG.printf("| %s T%6.1f K%6.1f", LEG_NAME[leg],
                        curAngle[leg][JOINT_THIGH], curAngle[leg][JOINT_KNEE]);
          if (pTurn) LOG.printf(" H%6.1f", curAngle[leg][JOINT_HIP]);
          LOG.print(" ");

        }
        LOG.println();
      }
      break;
    }

    case MODE_HOLD:
      slewToTargets(RAMP_RATE_DPS);         // удержание последней цели
      break;

    case MODE_IDLE:
    default:
      break;
  }

  // Кадр целиком, одним махом. Только режимы, которые действительно считали
  // новые углы: в IDLE и ARM в pendingTicks лежит прошлое, выдавать его нельзя.
  if (mode == MODE_RAMP || mode == MODE_WALK || mode == MODE_HOLD) pcaFlush();

#if SPOTTY_WEB
  webPublish(now);
#endif
}
