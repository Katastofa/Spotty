// Пиковая требуемая скорость сустава при заданном периоде, градусы в секунду.
// Форма траектории у всех четырёх ног одна, отличаются только сдвиг фазы и
// (в развороте) знак хипа. Максимум модуля производной от этого не зависит,
// поэтому достаточно одной ноги и одного прохода.
float peakRateDps(float cycleMs) {
  const int N = 400;
  float ang[JOINT_PER_LEG], prev[JOINT_PER_LEG], peak = 0.0f;
  /* ОДНОЙ НОГИ ХВАТАЕТ НЕ ВСЕГДА. Пока сдвиг корпуса по фазе выключен,
     траектории ног отличаются только сдвигом фазы, и максимум модуля
     производной у них общий. Со включённым сдвигом это неверно: сдвиг —
     функция ГЛОБАЛЬНОЙ фазы, и у каждой ноги он ложится на её собственный
     перенос по-своему. Тогда считаем все четыре — вчетверо дороже, но
     заниженный пик означал бы заниженный ограничитель скорости, то есть
     срезанную амплитуду и поехавшую фазировку. */
  const uint8_t nLeg = (pShiftGain > 0.0f && pEngine == 1) ? LEG_COUNT : 1;
  for (uint8_t leg = 0; leg < nLeg; leg++) {
    gaitPose(leg, 0.0f, prev);
    for (int k = 1; k <= N; k++) {
      gaitPose(leg, (float)k / (float)N, ang);
      for (uint8_t j = 0; j < JOINT_PER_LEG; j++) {
        peak = fmaxf(peak, fabsf(ang[j] - prev[j]));
        prev[j] = ang[j];
      }
    }
  }
  return peak * (float)N * 1000.0f / cycleMs;
}

/*
 * ШАГ РАЗГОНА. Укорачивает период и ПОДНИМАЕТ ВМЕСТЕ С НИМ ограничитель.
 *
 * Поднимать ограничитель обязательно: иначе разгон упрётся в наш же софтовый
 * предел и измерит его, а не серво. Задача обратная — найти, где начинает
 * отставать ЖЕЛЕЗО. Предел сустава при этом остаётся жёстким и неприкосновенным:
 * скорость и пределы — разные вещи, кламп работает как работал.
 *
 * Останов: 'x' оператором, либо потолок RATE_CEILING_DPS, либо SPEEDRAMP_MIN_MS.
 */
void speedRampStep() {
  float next = pCycleMs * SPEEDRAMP_FACTOR;
  if (next < SPEEDRAMP_MIN_MS) {
    LOG.printf(">> РАЗГОН: достигнут минимальный период %.0f мс. Останов.\n", pCycleMs);
    speedRamping = false; setTargetsToPose();
    beginRamp(millis());
    return;
  }
  // Ограничитель ведём с запасом 20% над требуемым, иначе мерили бы себя.
  float needed = peakRateDps(next);
  float lim    = needed * 1.2f;
  if (lim > RATE_CEILING_DPS) {
    LOG.printf(">> РАЗГОН: на периоде %.0f мс потребовалось бы %.0f°/с — выше потолка %.0f. Останов.\n",
                  next, needed, RATE_CEILING_DPS);
    speedRamping = false; setTargetsToPose();
    beginRamp(millis());
    return;
  }
  pCycleMs    = next;
  pMaxRateDps = lim;
  LOG.printf(">> РАЗГОН: период %.0f мс, требуется %.0f°/с, лимит поднят до %.0f°/с\n",
                pCycleMs, needed, pMaxRateDps);
  LOG.println("   Смотри на ноги. Как только начнут отставать или загудят — 'x'.");
}

