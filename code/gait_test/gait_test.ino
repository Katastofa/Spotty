/* ===========================================================================
 * ПРИСЕД И МОДЕЛЬ ЗВЕНЬЕВ — добавлено 2026-08-28
 * ---------------------------------------------------------------------------
 * ПОЧЕМУ ЭТО НЕ НАРУШАЕТ ЗАПРЕТ НА ВЫДУМАННЫЕ ДЛИНЫ ЗВЕНЬЕВ.
 *
 * Политика проекта запрещает изобретать межосевые расстояния: их не измеряли.
 * Но для приседа и для шага по ровной траектории АБСОЛЮТНЫЕ ДЛИНЫ НЕ НУЖНЫ.
 * Нужно только их ОТНОШЕНИЕ, потому что все нужные величины — углы, а масштаб
 * в них сокращается. Ниже бедро принято за единицу, голень за LINK_RATIO.
 *
 * Обозначения (x вперёд, z вниз, всё в плоскости ноги):
 *   θ  угол бедра   от вертикали, + = вперёд   (соглашение проекта)
 *   φ  угол колена, 0 = голень продолжает бедро, + = сгибание, голень вперёд
 *   ψ  угол ВИРТУАЛЬНОЙ НОГИ — прямой от оси хипа к стопе, от вертикали
 *   ρ  длина виртуальной ноги в единицах бедра
 *
 * Стопа = бедро + голень как векторы:
 *   ρ(φ) = sqrt(1 + k² + 2k·cos φ)                         ... теорема косинусов
 *   α(φ) = atan2(k·sin φ, 1 + k·cos φ)                     ... отклонение стопы
 *                                                              от оси бедра
 *   ψ = θ + α(φ)   =>   θ = ψ − α(φ)
 *
 * ПОЗА ПРИСЕДА. Задаём φ0 (насколько согнуто колено) и требуем ψ = 0, то есть
 * стопа строго под осью хипа. Тогда θ0 = −α(φ0). Никаких длин.
 * При k = 1 это даёт красивое θ0 = −φ0/2: колено согнуто вдвое сильнее, чем
 * отведено назад бедро. Нога короче в cos(φ0/2) раз.
 *
 * ПЛОСКАЯ ТРАЕКТОРИЯ. Чтобы стопа шла по ГОРИЗОНТАЛИ на глубине ρ0, нужно
 *   ρ(ψ) = ρ0 / cos ψ,
 * то есть по краям хода нога должна вытягиваться. Обращаем ρ(φ) и получаем φ,
 * затем θ = ψ − α(φ). Снова никаких абсолютных длин.
 * Ход ограничен вытягиванием: ρ0/cos ψ ≤ 1 + k, откуда |ψ| ≤ acos(ρ0/(1+k)).
 * При k = 1 это ровно φ0/2 — то есть размах не может превысить отвод бедра.
 *
 * ЧТО ЗДЕСЬ ДОПУЩЕНО И ЧЕГО ЭТО СТОИТ.
 * LINK_RATIO = 1.0 — ЭТО ДОПУЩЕНИЕ, А НЕ ИЗМЕРЕНИЕ. Межосевые расстояния
 * бедра и голени не мерялись (PROJECT_STATUS.md, «Открытые вопросы»).
 * Цена ошибки ограничена и считается: при ψ = 0 стопа уходит вбок от оси
 * хипа на (Lголень − Lбедро)·sin(θ0) — то есть перекос ПОСТОЯННЫЙ, он не
 * копится и на вывешенном роботе безвреден. На плоской траектории ошибка
 * отношения даёт остаточную волну по высоте стопы, но не выход за пределы:
 * пределы стоят в углах и клампом защищены независимо от любой модели.
 *
 * Когда отношение измерят — правится ОДНО число, командой 'L' или здесь.
 * ===========================================================================
 */
// --------------------------- действующие параметры --------------------------
// Инициализируются пресетом выбранной походки, правятся с клавиатуры.
// Объявлены здесь, а не рядом с таблицей походок, потому что модель звеньев
// ниже читает pAmpKnee.
float pDuty, pAmpThigh, pAmpKnee, pCycleMs;
float pAmpHip = 5.0f;      // размах хипа в развороте, ±
int   pTurn   = 0;         // 0 нет разворота, +1 влево, -1 вправо

/* ---------------------------------------------------------------------------
 * ПАРАМЕТРЫ ДЕКАРТОВА ДВИЖКА (pEngine == 1). В угловом движке не участвуют.
 *
 * Здесь всё в МИЛЛИМЕТРАХ и градусах КОРПУСА, а не в градусах суставов.
 * Это и есть смысл порта: «шаг 40 мм» проверяется рулеткой, «размах бедра
 * ±12°» — нет.
 *
 * ЗАДАННОЕ РАВНО ФАКТИЧЕСКОМУ. В оригинале clearance и penetration задают
 * положение контрольных точек, через которые кривая безье не проходит:
 * 'clearance 0' при высоте 190 даёт 59 мм отрыва. Здесь pLiftMm и pPenetMm —
 * фактические миллиметры, пересчёт в контрольные точки делает oq_gait.h.
 * ------------------------------------------------------------------------- */
/* УМОЛЧАНИЯ ПОДОБРАНЫ ПОД ЭТО ЖЕЛЕЗО, А НЕ ВЗЯТЫ У АВТОРА.
 *
 * У OpenQuadruped пресеты вида T_swing = 0.2…0.4 с при L_span 40…70 мм. На
 * наших серво это требует 305…375 °/с по колену — вчетверо больше, чем
 * разрешено по умолчанию (100 °/с) и вчетверо больше, чем нужно угловому
 * движку на сопоставимой походке (79 °/с). Ограничитель срезал бы амплитуду,
 * фазировка поехала бы, и оператор увидел бы «не ту походку» на ровном месте.
 *
 * Пик держит КОЛЕНО, и он определяется отношением подъём/время переноса, а
 * не скоростью корпуса. Отсюда длинный перенос и умеренный подъём.
 * Набор ниже даёт период 1900 мс, duty 0.53 и пик 80 °/с — то есть тот же
 * режим, в котором угловой движок уже отработал прогон 29.08. */
int   pEngine    = 0;       // 0 угловой (как было), 1 декартов
float pHeightMm  = 190.0f;  // глубина стопы под осью хипа
float pSpanMm    =  30.0f;  // L_span: полуразмах шага (полный шаг = 2*L_span)
float pLiftMm    =  15.0f;  // ФАКТИЧЕСКИЙ подъём стопы в переносе
float pPenetMm   =   0.0f;  // ФАКТИЧЕСКИЙ продав опоры (0 = опора прямая)
float pVelMmS    =  60.0f;  // скорость корпуса -> T_stance = 2*L_span/V
float pSwingMs   = 900.0f;  // T_swing, время переноса
float pCrabDeg   =   0.0f;  // направление хода: 0 вперёд, +90 влево
float pShiftXMm  =   0.0f;  // сдвиг корпуса: + вперёд (стопы уезжают назад)
float pShiftYMm  =   0.0f;  // сдвиг корпуса: + влево
float pShiftGain =   0.0f;  // ПЕРЕНОС КОРПУСА ПО ФАЗЕ, доля расчётной
                            // амплитуды. 0 = ВЫКЛЮЧЕН, и это умолчание:
                            // пока оператор не подал 'B', поведение робота
                            // не отличается от прежнего ни на один микрон.
                            // Амплитуда руками НЕ задаётся — она считается
                            // из геометрии. См. bodyShiftAmpMm().
float pRollDeg   =   0.0f;  // крен:    + левый борт вверх
float pPitchDeg  =   0.0f;  // тангаж:  + нос вверх   — открыт с M4 2026-09-12
float pYawDeg    =   0.0f;  // рыскание:+ нос влево   — открыт с M4 2026-09-12

// Где какая нога стоит. Порядок совпадает с enum Leg: FR, FL, BR, BL.
static const float LEG_FWD [LEG_COUNT] = { +1.0f, +1.0f, -1.0f, -1.0f };
static const float LEG_LEFT[LEG_COUNT] = { -1.0f, +1.0f, -1.0f, +1.0f };

// Отказ IK: стопа вне досягаемости. Ставится в gaitPoseCartesian, читается
// предполётной и циклом хода. Обнуляется тем, кто начинает новый прогон.
bool     ikFail      = false;
uint8_t  ikFailLeg   = 0;
float    ikFailPhase = 0.0f;

float linkRatio  = 1.0f;    // ГОЛЕНЬ / БЕДРО. 1.0 = ДОПУЩЕНИЕ, не замер.
float pCrouchDeg = 60.0f;   // φ0: угол колена в опоре. 0 = прямая нога.
bool  pFlatPath  = false;   // false = дуга, true = плоская траектория стопы
bool  pSmoothSwing = false; // false = линейный перенос, true = сглаженный

/*
 * ПРОДОЛЬНЫЙ СДВИГ КОРПУСА (трим). Добавлено 2026-08-28.
 *
 * ЗАЧЕМ. Наша стойка ставит стопу СТРОГО под ось хипа, то есть опорный
 * четырёхугольник симметричен относительно геометрического центра корпуса.
 * Центр тяжести у SpotMicro там не находится: батарея и электроника смещают
 * его назад. Робот садится на корму.
 *
 * ВСЕ ТРИ СРАВНИМЫХ ПРОЕКТА ДЕРЖАТ ЗДЕСЬ НЕНУЛЕВУЮ КОНСТАНТУ, и все три —
 * в одну сторону, корпусом вперёд относительно стоп:
 *   mike4192/spotMicro   stand_front_x_offset = 0.015 м (передние стопы вперёд)
 *   OpenQuadruped        com_offset = 0.016 м, pos[0] += com_offset в IK()
 *   MangDang Mini Pupper x_shift = 0.007 м при delta_x = 0.059
 *   Boston Dynamics      body_translation_offset — штатный параметр Custom Gait
 * У mike4192 вдобавок сдвиг вперёд 35 мм против 5 мм назад — асимметрия сама
 * по себе говорит, что борются именно с задранным носом.
 *
 * НИ ОДНО ИЗ ЭТИХ ЧИСЕЛ НЕ ИЗМЕРЕНО ИЗ ГЕОМЕТРИИ. Это подобранные на стенде
 * константы; у mike4192 в конфиге лежит второй набор под trot с пометкой
 * «better tuned», то есть одно железо требует разной подгонки под походки.
 *
 * У НАС ЭТО ВЫРАЖАЕТСЯ БЕЗ МИЛЛИМЕТРОВ. Трим — это постоянная добавка к углу
 * ВИРТУАЛЬНОЙ НОГИ, одинаковая для всех четырёх ног. Знак: положительный
 * двигает КОРПУС ВПЕРЁД относительно стоп (стопы уезжают назад под корпусом).
 *
 * ВАЖНОЕ СВОЙСТВО: в ПЛОСКОМ режиме трим не меняет высоту вовсе. Глубина
 * стопы там равна ρ0 по построению при любом ψ, значит корпус едет строго
 * горизонтально и НЕ НАКЛОНЯЕТСЯ. Это ровно то, что делает mike4192, у
 * которого return_point.y при сдвиге не трогается. В режиме дуги высота
 * слегка меняется, но одинаково у всех четырёх ног, поэтому дифферента
 * тоже не возникает — только общая просадка.
 *
 * В миллиметрах величину назвать НЕЛЬЗЯ: для этого нужна продольная база,
 * а она в KINEMATICS_AUDIT.md честно помечена как неопределённая (135…232 мм).
 * Подбирается глазом или по фото строго сбоку.
 *
 * ЗНАЧЕНИЕ ПО УМОЛЧАНИЮ +17°, 2026-08-29. Источник — ОПЕРАТОР, подбор НА ГЛАЗ
 * на стенде: прогон trot с начальными настройками скетча (duty 0.50,
 * бедро ±12°, колено +15°, период 1200 мс, присед 60°, ДУГА, линейный
 * перенос), робот ВЫВЕШЕН. Это НЕ замер и НЕ вывод из геометрии, ровно как
 * у всех перечисленных выше проектов.
 *
 * ЧТО С ЭТИМ ЗНАЧЕНИЕМ НЕ ТАК И ПОЧЕМУ ОНО ВСЁ РАВНО СТОИТ ЗДЕСЬ.
 *   17° при ρ0 = 1.732 — это сдвиг стопы назад на 0.51 длины БЕДРА. Чтобы
 *   сойтись с чужими 15…16 мм, бедро должно быть около 30 мм, чего быть не
 *   может: наше заметно длиннее. Значит либо ЦТ действительно сильно дальше
 *   назад, либо трим подъедает ОБЩУЮ составляющую ошибки нулей бёдер —
 *   M9 не снят ни для одного канала, заявлено до ±7.2°. Трим одинаков для
 *   всех четырёх ног, поэтому компенсировать он может только общую часть
 *   ошибки, а не разброс между каналами.
 *   Разделить причины может только замер: M9_ПРОТОКОЛ.md либо фото сбоку.
 *   До этого 17° — рабочая подгонка, а не измеренная константа.
 *
 * ГДЕ ОНО УПИРАЕТСЯ. На ДУГЕ ни во что: бедро идёт −59°…−35°, ближайший
 * жёсткий предел BR(ch4) на −86.7°, запас 27.7°. (В первой редакции этого
 * блока стояло «FL(ch10) на −79.5°» — ошибка: знак ch10 и ch2 равен −1,
 * а не +1. Исправлено 2026-08-29, вывод не изменился.) На ПЛОСКОЙ траектории предполётная
 * считает ход = t + |b| против вылета ноги (±30° при приседе 60° и k = 1):
 * при t 12 это 29.0 из 29.5, запас полградуса. Любое t выше 12 или
 * сглаженный перенос 'S 1' проверку на 'f 1' уже не пройдут — это не
 * поломка, а честный отказ модели, лечится 't' меньше или приседом глубже.
 *
 * Вернуть прежнее поведение: 'b 0'. Прогон 2026-08-28 и вся арифметика
 * дифферента в PROJECT_STATUS считались при триме 0.
 */
float pTrimDeg = 17.0f;     // + = корпус вперёд. ПОДБОР ОПЕРАТОРА 2026-08-29,
                            // не замер. Прежнее умолчание было 0.0f.
float liftRho    = 0.0f;    // подъём стопы в переносе, в единицах бедра

/* ===========================================================================
 * ДЕКАРТОВА IK ОДНОЙ НОГИ.
 * ---------------------------------------------------------------------------
 * Система координат в оси хипа: x вперёд, y НАРУЖУ, z ВНИЗ (положительный).
 * «Наружу» — у левых ног влево, у правых вправо; зеркальность бортов дальше
 * учитывает JOINT_SIGN.
 *
 * ЧУЖУЮ IK ИЗ OpenQuadruped СЮДА НЕ СТАВИТЬ. Её формула делится на ноль
 * ровно на нашей геометрии: она предполагает вынос оси бедра с двумя
 * ненулевыми составляющими, а по STL у нас общий перпендикуляр 10.75 мм
 * идёт чисто по Z, вторая составляющая нулевая. Разбор — в шапке oq_gait.h.
 *
 * ИСПРАВЛЕН ЗНАК БЕДРА, 2026-08-31. Было `atan2(x,r) + acos(cg)`, стало
 * `− acos(cg)`. Заготовка была закрыта флагом SPOTTY_LINKS_MEASURED и ни
 * разу не компилировалась, поэтому расхождение не всплывало: она давала
 * +15.560° там, где угловой движок даёт −15.560°. После правки совпадение
 * с −alphaOf() точное на всех приседах.
 *
 * Возвращает false, если точка недостижима — вызывающий ОБЯЗАН это проверить
 * и остановиться, а не подставлять последнее удачное значение.
 * =========================================================================== */
bool legIK(float x, float y, float z, float &hip, float &thigh, float &knee) {
  const float d2 = y * y + z * z;
  if (d2 < L_HIP_MM * L_HIP_MM) return false;
  const float r = sqrtf(d2 - L_HIP_MM * L_HIP_MM);
  hip = degrees(atan2f(z, y) - atan2f(r, L_HIP_MM));

  const float L = sqrtf(x * x + r * r);
  if (L > L_FEMUR_MM + L_TIBIA_MM - 0.001f) return false;
  if (L < fabsf(L_FEMUR_MM - L_TIBIA_MM) + 0.001f) return false;

  const float ci = (L_FEMUR_MM * L_FEMUR_MM + L_TIBIA_MM * L_TIBIA_MM - L * L)
                   / (2.0f * L_FEMUR_MM * L_TIBIA_MM);
  knee = degrees(PI - acosf(constrain(ci, -1.0f, 1.0f)));   // + = сгибание

  const float cg = (L * L + L_FEMUR_MM * L_FEMUR_MM - L_TIBIA_MM * L_TIBIA_MM)
                   / (2.0f * L * L_FEMUR_MM);
  thigh = degrees(atan2f(x, r) - acosf(constrain(cg, -1.0f, 1.0f)));  // + = вперёд
  return true;
}

// ρ(φ) — длина виртуальной ноги в единицах бедра.
float reachOf(float kneeDeg) {
  const float k = linkRatio, c = cosf(radians(kneeDeg));
  return sqrtf(1.0f + k * k + 2.0f * k * c);
}

// α(φ) — на сколько градусов стопа отклонена от оси бедра.
float alphaOf(float kneeDeg) {
  const float k = linkRatio, r = radians(kneeDeg);
  return degrees(atan2f(k * sinf(r), 1.0f + k * cosf(r)));
}

// Обратная задача: какой угол колена даёт заданную длину. Всегда определена —
// требуемая длина зажимается в физически достижимый диапазон звеньев.
// Это НЕ защита сустава (её делает кламп), а защита от NaN в acos.
float kneeForReach(float rho) {
  const float k = linkRatio;
  const float lo = fabsf(1.0f - k) + 1e-4f, hi = 1.0f + k - 1e-4f;
  rho = constrain(rho, lo, hi);
  float c = constrain((rho * rho - 1.0f - k * k) / (2.0f * k), -1.0f, 1.0f);
  return degrees(acosf(c));
}

// Поза приседа: стопа под осью хипа.
float stanceThighDeg() { return -alphaOf(pCrouchDeg); }
float stanceReach()    { return reachOf(pCrouchDeg); }

// Предельный размах виртуальной ноги: дальше нога просто не дотягивается.
float sweepLimitDeg() {
  float c = stanceReach() / (1.0f + linkRatio);
  if (c >= 1.0f) return 0.0f;               // нога уже вытянута полностью
  return degrees(acosf(constrain(c, -1.0f, 1.0f)));
}

// Подъём стопы в переносе выражен через ТОТ ЖЕ параметр ampKnee, что и в
// режиме дуги: берём, насколько укоротилась бы нога, догни мы колено на
// ampKnee градусов от приседа. Так два режима сравнимы по одному числу —
// а сравнить их глазом на стенде и есть смысл переключателя.
void recalcLift() {
  float kneeMax = pCrouchDeg + pAmpKnee;
  if (kneeMax > 175.0f) kneeMax = 175.0f;
  liftRho = reachOf(pCrouchDeg) - reachOf(kneeMax);
  if (liftRho < 0.0f) liftRho = 0.0f;
}

struct GaitDef {
  const char *name;
  const char *note;
  float phase[LEG_COUNT];   // FR, FL, BR, BL
  float duty;               // доля цикла в опоре
  float ampThigh, ampKnee;  // градусы
  float cycleMs;
};

// ПОРЯДОК ПОДЪЁМА НОГ У WALK. Нога уходит в перенос, когда её собственная
// фаза переваливает duty, то есть в глобальной фазе (duty - phase[нога]).
// При duty 0.75 это даёт:
//     BL 0.00 -> FL 0.25 -> BR 0.50 -> FR 0.75
// то есть ЗЛ, ПЛ, ЗП, ПП — боковая последовательность (lateral sequence),
// которой ходит шагом собака: за задней ногой идёт передняя ТОГО ЖЕ борта.
//
// Первая редакция этой таблицы давала BL, FR, BR, FL — диагональную
// последовательность (за задней идёт передняя ПРОТИВОПОЛОЖНОГО борта).
// Она тоже устойчива, но это походка приматов, а не собаки, и как эталонный
// узор для проверки карты каналов она хуже: диагональный порядок легко
// спутать с перепутанной парой каналов. Исправлено 2026-08-28.
static const GaitDef GAITS[] = {
  { "trot",   "диагонали синфазны",
    { 0.00f, 0.50f, 0.50f, 0.00f }, 0.50f, 12.0f, 15.0f, 1200.0f },
  { "pace",   "борта синфазны, проверка зеркальности бортов",
    { 0.00f, 0.50f, 0.00f, 0.50f }, 0.50f, 12.0f, 15.0f, 1200.0f },
  { "bound",  "перед синфазно, зад синфазно, проверка оси перёд-зад",
    { 0.00f, 0.00f, 0.50f, 0.50f }, 0.50f, 10.0f, 15.0f, 1000.0f },
  { "walk",   "4 такта, duty 0.75, подъём BL-FL-BR-FR",
    { 0.00f, 0.50f, 0.25f, 0.75f }, 0.75f, 12.0f, 18.0f, 2400.0f },
  { "gallop", "rotary, сдвиг внутри пар",
    { 0.00f, 0.10f, 0.60f, 0.50f }, 0.40f,  8.0f, 12.0f,  900.0f },
};
static const uint8_t GAIT_COUNT = sizeof(GAITS) / sizeof(GAITS[0]);
uint8_t gaitIdx = 0;

/*
 * РАЗВОРОТ ЧЕРЕЗ ХИПЫ.
 *
 * Разворот влево (против часовой, вид сверху) означает, что относительно
 * корпуса стопы в опоре идут ПО часовой: передние вправо, задние влево.
 * По соглашению «хип + = наружу от корпуса» это даёт диагональный узор:
 *
 *     FR наружу (+)   FL внутрь (-)
 *     BR внутрь (-)   BL наружу (+)
 *
 * Проверка вывода. Корпус поворачивается CCW, значит опорные стопы идут
 * относительно корпуса ПО часовой: скорость точки (x,y) равна (y, -x).
 *   FR (x>0,y<0): вбок -y = вправо = НАРУЖУ для правой ноги  -> хип растёт
 *   FL (x>0,y>0): вбок -y = вправо = ВНУТРЬ  для левой ноги  -> хип падает
 *   BR (x<0,y<0): вбок +y = влево  = ВНУТРЬ  для правой ноги -> хип падает
 *   BL (x<0,y>0): вбок +y = влево  = НАРУЖУ  для левой ноги  -> хип растёт
 * Узор диагональный — и это совпадает с диагональностью самих знаков хипов
 * (CALIBRATION.md §2.1.7). Ошибка в знаке хипа вылезет здесь сразу.
 *
 * ЧТО БУДЕТ ВИДНО НА СТЕНДЕ И НЕ ЯВЛЯЕТСЯ ОШИБКОЙ. При duty 0.5 (trot, pace,
 * bound) опора и перенос — зеркальные половины, поэтому у ног в противофазе
 * знак ноги и знак фазы взаимно сокращаются, и ВСЕ ЧЕТЫРЕ ХИПА ПОКАЗЫВАЮТ
 * ОДНО И ТО ЖЕ ЧИСЛО. Со стороны это выглядит как боковое качание корпуса,
 * а не как разворот. Так и должно быть: момент создают только две опорные
 * ноги, а их стопы в этот миг идут в разные стороны. Чтобы разворот было
 * ВИДНО, смотреть его на walk (duty 0.75), где все четыре ноги в разных
 * фазах.
 *
 * ОСТОРОЖНО С АМПЛИТУДОЙ. Ход хипов НЕСИММЕТРИЧЕН: наружу 49…54°, а внутрь
 * всего 17…21° (ch9 -16.7° — самый тесный). Симметричный размах вокруг нуля
 * ограничен именно внутренней стороной. Предполётная проверка это ловит,
 * но держать AMP_HIP выше 8° смысла нет.
 *
 * НА ВЫВЕШЕННОМ РОБОТЕ РАЗВОРОТ НИЧЕГО НЕ РАЗВОРАЧИВАЕТ. Проверяется ровно
 * одно: что хипы ходят в нужную сторону и не выходят за предел.
 */
static const float TURN_SIGN[LEG_COUNT] = {
  /* FR */ +1.0f, /* FL */ -1.0f, /* BR */ -1.0f, /* BL */ +1.0f
};

/*
 * ДВА ОГРАНИЧИТЕЛЯ СКОРОСТИ, И ЭТО НАМЕРЕННО.
