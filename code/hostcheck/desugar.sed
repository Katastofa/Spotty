# ===========================================================================
# ПРАВИЛА ПОДГОТОВКИ ВРЕМЕННОЙ КОПИИ gait_test.ino ДЛЯ СТЕНДА.
#
# Один файл на два сборщика (build.sh и crossbuild.sh) намеренно: правила
# лежали в обоих по отдельности, разошлись на одной строке — и стенд под
# Windows собрался бы без того, что уже работает под Linux. Здесь их одна
# копия, и разойтись им больше негде.
#
# ВСЁ, ЧТО ЗДЕСЬ ДЕЛАЕТСЯ, — снятие static с констант, чтобы стенд мог их
# ПРОЧИТАТЬ. Ни одного числа, ни одной формулы не меняется. В прошивке они
# остаются static: правится временная копия в /tmp.
# ===========================================================================

# Веб-морда на хосте не нужна и не собирается.
s/^#define SPOTTY_WEB 1/#define SPOTTY_WEB 0/

# Геометрия звеньев и стопы.
s/^static const float L_\(FEMUR\|TIBIA\|HIP\)_MM/extern const float L_\1_MM/
s/^static const float \(R_FOOT_MM\|BASE_LAT_MM\)/extern const float \1/

# Где какая нога стоит: FR, FL, BR, BL -> +-1. Нужно воротам, которые
# проверяют знак переноса корпуса против фазировки.
s/^static const float LEG_\(FWD\|LEFT\)/extern const float LEG_\1/

# Пресеты походок и период тика.
s/^static const GaitDef GAITS\[\]/extern const GaitDef GAITS[]/
s/^static const uint16_t TICK_MS/extern const uint16_t TICK_MS/

# ПРОДОЛЬНАЯ БАЗА — единственная строка, где снимается ещё и const.
# Она НЕ ИЗМЕРЕНА (M4), в прошивке равна нулю, и всё, что от неё зависит,
# на роботе честно отказывает. Но симулятору считать на нуле нечего, а
# подставить число ВНУТРИ симулятора значило бы завести второй источник
# геометрии. Поэтому ПРИНЯТОЕ значение подаётся в ту же переменную прошивки
# (trace: baselong=180), откуда его читает тот же самый код, и стенд обязан
# напечатать это в поле base_long_source.
s/^static const float BASE_LONG_MM/float BASE_LONG_MM/
